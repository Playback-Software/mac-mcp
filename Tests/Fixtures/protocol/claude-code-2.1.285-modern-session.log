1791210646.474 << {"id":1,"jsonrpc":"2.0","result":{"_meta":{"io.modelcontextprotocol/serverInfo":{"name":"mac-mcp","version":"0.1.0 (68851a3+dirty-20261005073008)"}},"content":[{"text":"mac-mcp 0.1.0 (68851a3+dirty-20261005073008) — agent pid 23201, client: claude-code 2.1.285\n\nSession\n  OK  GUI session on console: yes\n  OK  screen: unlocked\n  OK  display: awake\n      launchd session: Aqua (must be Aqua)\n\nControl\n      GUI lease: free\n      action lock: idle\n\nPermissions (granted to MacMCP.app, com.playbacksoftware.macmcp)\n  OK  Accessibility: granted\n  OK  Screen Recording: granted\n\nAutomation (mac_script, granted to MacMCP per app)\n  OK  Finder: granted\n      TextEdit: not running (can't check until it is)\n      Safari: not running (can't check until it is)\n\nIdentity\n  OK  signing: com.playbacksoftware.macmcp, team ABCDE12345\n\nPolicy (/Users/you/.config/mac-mcp/policy.json)\n  OK  deny_apps: none\n      allow_apps: any app not denied\n      mac_script may control: Finder, TextEdit, Safari (timeout 30 s)\n      clipboard reads: allowed  ·  rate limit: 10.0 actions/s\n      alerts: agent log only (set alert_webhook to get notified when a person is needed)\n\nDisplays\n      display 3: 1920x1080 points at (0,0), scale 1.0x\n\nFiles\n      socket: /Users/you/Library/Application Support/MacMCP/mcp.sock\n      agent log: /Users/you/Library/Logs/MacMCP/agent.log\n      audit log: /Users/you/Library/Logs/MacMCP/audit.jsonl\n\nActions can run.","type":"text"}],"isError":false,"resultType":"complete"}}
